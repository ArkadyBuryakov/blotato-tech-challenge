# Local development (pnpm dev). Defaults work with `docker compose up -d` and mock Instagram.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/automations
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
INSTAGRAM_MODE=mock
# INSTAGRAM_MODE=live requires:
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=dev-verify-token
COMMENT_RECONCILER=false
ENABLE_DEV_TOOLS=true
